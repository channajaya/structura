{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structuraeng.app/schemas/approval-record.schema.json",
  "title": "STRUCTURA approval record",
  "description": "Human release attestation bound to one staged HTTPS deployment origin, candidate Git commit and exact artifact hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "product_sku",
    "risk_level",
    "release_tag",
    "candidate_commit_sha",
    "candidate_deployment_url",
    "artifact_hashes",
    "decision",
    "conditions",
    "reviewers",
    "reviewed_at",
    "evidence",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,95}$"
    },
    "product_sku": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "risk_level": {
      "enum": ["A", "B", "C"]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "candidate_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_deployment_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[0-9]{1,5})?/?$"
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    },
    "decision": {
      "enum": [
        "PENDING",
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "RETURNED_FOR_REWORK",
        "REJECTED"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "reviewed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "decision", "reviewed_at"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "enum": ["OWNER", "MAINTAINER", "COMMERCIAL_REVIEWER", "ENGINEER", "INDEPENDENT_CHECKER"]
        },
        "decision": {
          "enum": ["PENDING", "APPROVED", "RETURNED_FOR_REWORK", "REJECTED"]
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "APPROVED_WITH_CONDITIONS"
          }
        }
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
